<Window x:Class="PS5Craft.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление PS5Craft"
        Width="460" Height="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BrushWindowBg}"
        Foreground="White"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Border BorderBrush="#1D3C5C" BorderThickness="1" Background="#0A1624" CornerRadius="8" Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#0C2138" CornerRadius="8,8,0,0" MouseLeftButtonDown="OnHeaderDrag">
        <DockPanel Margin="18,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Content="&#xE8BB;" Width="36" Height="32"
                  Click="OnLater" VerticalAlignment="Center" />
          <TextBlock x:Name="TitleText" Text="Доступно обновление" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="22,16,22,18">
        <!-- Offer -->
        <StackPanel x:Name="OfferPanel">
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <TextBlock Text="Установлена версия:" Foreground="#A9BBCF" VerticalAlignment="Center" />
            <TextBlock x:Name="CurrentVersionText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Новая версия:" Foreground="#A9BBCF" VerticalAlignment="Center" />
            <TextBlock x:Name="NewVersionText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"
                       Foreground="#4DB0FF" VerticalAlignment="Center" />
          </Grid>

          <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13.5" Foreground="#CFE0F2"
                     LineHeight="20" MaxHeight="110" TextTrimming="CharacterEllipsis" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource SecondaryButton}" Height="36" Content="Подробнее" Click="OnDetails" Margin="0,0,8,0" />
            <Button Style="{StaticResource SecondaryButton}" Height="36" Content="Позже" Click="OnLater" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryAction}" Height="36" Click="OnUpdate">
              <TextBlock Text="Обновить" FontWeight="SemiBold" Margin="12,0" />
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Download -->
        <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" VerticalAlignment="Center">
          <TextBlock Text="Загрузка обновления..." FontSize="14" Margin="0,0,0,12" />
          <ProgressBar x:Name="DownloadBar" Height="14" Minimum="0" Maximum="100" Value="0" />
          <DockPanel Margin="0,10,0,0">
            <TextBlock x:Name="DownloadPercentText" Text="0%" FontWeight="SemiBold" />
            <TextBlock x:Name="DownloadSizeText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#A9BBCF" />
          </DockPanel>
          <Button Style="{StaticResource SecondaryButton}" Height="36" Content="Отмена" HorizontalAlignment="Right"
                  Margin="0,18,0,0" Click="OnCancelDownload" />
        </StackPanel>

        <!-- Error -->
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center">
          <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="14" Foreground="#FFB4A8" LineHeight="20" />
          <Button Style="{StaticResource PrimaryAction}" Height="36" HorizontalAlignment="Right" Margin="0,18,0,0"
                  Click="OnErrorClose">
            <TextBlock Text="Закрыть" FontWeight="SemiBold" Margin="12,0" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
