<Application x:Class="PS5Craft.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PS5Craft.App.Converters">
    <Application.Resources>
    <ResourceDictionary>
      <conv:PageVisibilityConverter x:Key="PageVis" />
      <conv:PageIsConverter x:Key="PageIs" />
      <conv:StepStateConverter x:Key="StepState" />
      <conv:NullToVisibilityConverter x:Key="NullVis" />
      <conv:BytesToStringConverter x:Key="Bytes" />
      <conv:BoolToVisConverter x:Key="BoolVis" />
      <conv:InverseBoolToVisConverter x:Key="InvBoolVis" />
      <conv:LogLineBrushConverter x:Key="LogBrush" />
      <conv:FlagConverter x:Key="Flag" />

      <!-- ===== Palette ===== -->
      <Color x:Key="CBg">#06111F</Color>
      <Color x:Key="CSidebar">#07182A</Color>
      <Color x:Key="CPanel">#0B1C2E</Color>
      <Color x:Key="CBorder">#153550</Color>
      <Color x:Key="CAccent">#087FF5</Color>
      <Color x:Key="CAccentHot">#008CFF</Color>
      <Color x:Key="CText">#FFFFFF</Color>
      <Color x:Key="CMuted">#9FB0C3</Color>

      <SolidColorBrush x:Key="BrushBg" Color="{StaticResource CBg}" />
      <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource CSidebar}" />
      <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource CPanel}" />
      <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource CBorder}" />
      <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource CAccent}" />
      <SolidColorBrush x:Key="BrushAccentHot" Color="{StaticResource CAccentHot}" />
      <SolidColorBrush x:Key="BrushText" Color="{StaticResource CText}" />
      <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource CMuted}" />
      <SolidColorBrush x:Key="BrushInput" Color="#081626" />
      <SolidColorBrush x:Key="BrushInputBorder" Color="#1B3D5C" />
      <SolidColorBrush x:Key="BrushCell" Color="#0A1A2B" />
      <SolidColorBrush x:Key="BrushCellLabel" Color="#081727" />
      <SolidColorBrush x:Key="BrushSuccess" Color="#3BE36A" />
      <SolidColorBrush x:Key="BrushWarn" Color="#F0B429" />

      <LinearGradientBrush x:Key="BrushWindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#040C17" Offset="0" />
        <GradientStop Color="#071528" Offset="0.5" />
        <GradientStop Color="#050E1A" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushPanelBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0C1F33" Offset="0" />
        <GradientStop Color="#0A1A2B" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushAccentFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A94FF" Offset="0" />
        <GradientStop Color="#0873E6" Offset="1" />
      </LinearGradientBrush>

      <DropShadowEffect x:Key="AccentGlow" Color="#1E8CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />
      <DropShadowEffect x:Key="SoftGlow" Color="#1E8CFF" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />

      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

      <!-- ===== Vector icons (24x24 design grid) ===== -->
      <Geometry x:Key="IconOpenBox">M4,9.5 L12,12.5 L20,9.5 L20,18.5 L12,21.5 L4,18.5 Z M12,12.5 L12,21.5 M4,9.5 L1.6,6 L9.6,3 L12,6.4 M20,9.5 L22.4,6 L14.4,3 L12,6.4 M4,9.5 L12,6.4 L20,9.5</Geometry>
      <Geometry x:Key="IconCube">M12,2.5 L20.5,7 L20.5,17 L12,21.5 L3.5,17 L3.5,7 Z M3.5,7 L12,11.5 L20.5,7 M12,11.5 L12,21.5 M7.8,4.8 L16.2,9.2</Geometry>
      <Geometry x:Key="IconInfo">M12,2.5 A9.5,9.5 0 1 1 11.99,2.5 Z M12,11 L12,17 M12,7.4 L12,7.6</Geometry>
      <Geometry x:Key="IconWrench">M21.4,6.2 L17.9,9.7 L14.6,9.4 L14.3,6.1 L17.8,2.6 A5.6,5.6 0 0 0 11.4,9.9 L2.9,18.4 A2.1,2.1 0 0 0 5.6,21.1 L14.1,12.6 A5.6,5.6 0 0 0 21.4,6.2 Z</Geometry>
      <Geometry x:Key="IconFolder">M2.5,6 A1.5,1.5 0 0 1 4,4.5 L9,4.5 L11,6.8 L20,6.8 A1.5,1.5 0 0 1 21.5,8.3 L21.5,18 A1.5,1.5 0 0 1 20,19.5 L4,19.5 A1.5,1.5 0 0 1 2.5,18 Z M2.5,9.5 L21.5,9.5</Geometry>
      <Geometry x:Key="IconTrash">M4,6.5 L20,6.5 M9.5,6.5 L9.5,4 L14.5,4 L14.5,6.5 M6,6.5 L7,20 L17,20 L18,6.5 M10,10 L10,16.5 M14,10 L14,16.5</Geometry>
      <Geometry x:Key="IconSave">M4,4 L17,4 L20,7 L20,20 L4,20 Z M8,4 L8,9 L15,9 L15,4 M7.5,20 L7.5,13.5 L16.5,13.5 L16.5,20</Geometry>
      <Geometry x:Key="IconCheck">M2,7 L6,11 L14,2.5</Geometry>

      <!-- ===== Text ===== -->
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
      </Style>

      <Style x:Key="MetaLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>

      <Style x:Key="MetaValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>

      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#C9D5E2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- ===== Panels ===== -->
      <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanelBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>

      <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- Metadata table row: bordered label cell + bordered value cell -->
      <Style x:Key="MetaRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="#12304A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource BrushCell}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>

      <!-- ===== Buttons ===== -->
      <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>

      <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource BrushAccentFill}" />
        <Setter Property="BorderBrush" Value="#3AA4FF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="8" Effect="{StaticResource AccentGlow}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,8" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#2A9DFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#0766CC" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Background" Value="#123456" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#1B3D5C" />
                  <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                  <Setter Property="Foreground" Value="#6F86A0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#0F2439" />
        <Setter Property="BorderBrush" Value="#1F4466" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#16324F" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#2C6AA3" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#0B1C2E" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="FolderButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ToolTip" Value="Обзор…" />
        <Setter Property="ContentTemplate">
          <Setter.Value>
            <DataTemplate>
              <Path Data="{StaticResource IconFolder}" Stroke="#DCE6F2" StrokeThickness="1.6" Width="20" Height="20"
                    Stretch="Uniform" StrokeLineJoin="Round" />
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="HeaderLinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#12263D" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#16304D" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ===== Sidebar navigation cards ===== -->
      <Style x:Key="NavCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Margin" Value="14,0,14,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="nav" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" Background="#0C2138" BorderBrush="#16385C" Padding="16,0">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#10294A" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#23507E" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentFill}" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#4DB0FF" />
                  <Setter TargetName="Bd" Property="Effect" Value="{StaticResource AccentGlow}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="White" />
        <Setter Property="StrokeThickness" Value="1.9" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="NavTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
      </Style>
      <Style x:Key="NavSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="#C6D4E3" />
        <Setter Property="Margin" Value="0,2,0,0" />
      </Style>

      <!-- ===== Workflow stepper segment ===== -->
      <Style x:Key="StepSegment" TargetType="HeaderedContentControl">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="HeaderedContentControl">
              <Grid>
                <Path x:Name="Shape" Stretch="Fill" Data="M0,0 L0.955,0 L1,0.5 L0.955,1 L0,1 Z"
                      Fill="Transparent" />
                <Path x:Name="Chevron" Stretch="Fill" Data="M0.955,0 L1,0.5 L0.955,1" Stroke="#1D4466" StrokeThickness="1.5" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,26,0">
                  <Border x:Name="Circle" Width="34" Height="34" CornerRadius="17" BorderThickness="1.5"
                          BorderBrush="#2A5780" Background="#0E243B" Margin="0,0,14,0">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.FontSize="17" TextElement.FontWeight="SemiBold" />
                  </Border>
                  <ContentPresenter VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="Active">
                  <Setter TargetName="Shape" Property="Fill">
                    <Setter.Value>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0A63C4" Offset="0" />
                        <GradientStop Color="#0D4E96" Offset="1" />
                      </LinearGradientBrush>
                    </Setter.Value>
                  </Setter>
                  <Setter TargetName="Chevron" Property="Stroke" Value="#3A9BFF" />
                  <Setter TargetName="Circle" Property="Background" Value="{StaticResource BrushAccentHot}" />
                  <Setter TargetName="Circle" Property="BorderBrush" Value="#7CC4FF" />
                  <Setter TargetName="Circle" Property="Effect" Value="{StaticResource SoftGlow}" />
                </Trigger>
                <Trigger Property="Tag" Value="Done">
                  <Setter TargetName="Circle" Property="Background" Value="#0D3A66" />
                  <Setter TargetName="Circle" Property="BorderBrush" Value="#1F74C8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="StepTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
      </Style>
      <Style x:Key="StepSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#AFC0D2" />
        <Setter Property="Margin" Value="0,1,0,0" />
      </Style>

      <!-- ===== Inputs ===== -->
      <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Background" Value="{StaticResource BrushInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentHot}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#2C6AA3" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#DCE6F2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,34,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1.5"
                        BorderBrush="#2A5780" Background="#081626" VerticalAlignment="Center">
                  <Path x:Name="Mark" Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.2"
                        Stretch="Uniform" Width="11" Height="9" Visibility="Collapsed"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushAccentHot}" />
                  <Setter TargetName="Box" Property="BorderBrush" Value="#4DB0FF" />
                  <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="#5AB6FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ComboBox -->
      <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{StaticResource BrushInput}" BorderBrush="{StaticResource BrushInputBorder}"
                BorderThickness="1" CornerRadius="6">
          <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource BrushMuted}"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Bd" Property="BorderBrush" Value="#2C6AA3" />
          </Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentHot}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>

      <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press" />
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                  Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="Fade">
                  <Border Background="#0B1C2E" BorderBrush="#23507E" BorderThickness="1" CornerRadius="6"
                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                          MaxHeight="300" Margin="0,2,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter Margin="2" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#16324F" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Slim scrollbars -->
      <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Border x:Name="Bd" Background="#2A4E73" CornerRadius="4" />
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#3A6D9E" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="#0A1A2B" CornerRadius="4">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" Margin="1" />
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Border Background="#0A1A2B" CornerRadius="4">
                    <Track x:Name="PART_Track">
                      <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}" Margin="1" />
                      </Track.Thumb>
                    </Track>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Green progress bar -->
      <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid>
                <Border x:Name="PART_Track" Background="#0A1E33" BorderBrush="#16385C" BorderThickness="1" CornerRadius="8" />
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="8" Margin="1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#6BF58F" Offset="0" />
                      <GradientStop Color="#2FD35C" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.Effect>
                    <DropShadowEffect Color="#3BE36A" BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
                  </Border.Effect>
                </Border>
                <Border x:Name="Indeterminate" CornerRadius="8" Margin="1" ClipToBounds="True" Visibility="Collapsed">
                  <Rectangle x:Name="Glider" Width="160" HorizontalAlignment="Left" RadiusX="7" RadiusY="7">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#003BE36A" Offset="0" />
                        <GradientStop Color="#FF3BE36A" Offset="0.5" />
                        <GradientStop Color="#003BE36A" Offset="1" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                      <TranslateTransform x:Name="GliderShift" X="-160" />
                    </Rectangle.RenderTransform>
                  </Rectangle>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsIndeterminate" Value="True">
                  <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible" />
                  <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Glide">
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="GliderShift" Storyboard.TargetProperty="X"
                                         From="-160" To="1400" Duration="0:0:2.2" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Glide" />
                  </Trigger.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Log list -->
      <Style x:Key="LogItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd" Background="Transparent" Padding="8,1">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#12304D" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#0B1C2E" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#23507E" />
      </Style>
    </ResourceDictionary>
    </Application.Resources>
</Application>
