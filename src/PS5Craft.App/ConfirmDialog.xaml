<Window x:Class="PS5Craft.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS5Craft" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BrushWindowBg}" Foreground="White" FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Border BorderBrush="#1D3C5C" BorderThickness="1" Background="#0A1624" CornerRadius="8" Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="#0C2138" CornerRadius="8,8,0,0">
        <TextBlock x:Name="TitleText" Text="Подтверждение" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="18,0" />
      </Border>
      <StackPanel Grid.Row="1" Margin="22,16,22,18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="#CFE0F2" LineHeight="22" />
        <StackPanel x:Name="PathPanel" Visibility="Collapsed" Margin="0,14,0,0">
          <TextBlock Text="Папка на консоли" FontSize="13" Foreground="#A9BBCF" Margin="0,0,0,6" />
          <TextBox x:Name="PathBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                   ToolTip="Например /data/etaHEN/homebrew" />
          <TextBlock Text="Можно изменить. Путь сохранится как значение по умолчанию."
                     FontSize="12" Foreground="#7E93A8" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Height="36" Content="Отмена"
                  Click="OnCancel" Margin="0,0,8,0" />
          <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryAction}" Height="36" Click="OnConfirm">
            <TextBlock Text="Да" FontWeight="SemiBold" Margin="12,0" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
